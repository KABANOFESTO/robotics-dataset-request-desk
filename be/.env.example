DJANGO_DEBUG=True
DJANGO_SECRET_KEY=dev-only-insecure-key-change-this-in-production
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTO_SETUP_ON_RUNSERVER=False
AUTO_SEED_USERS=False
SEED_USERS_ALLOW_WEAK_PASSWORDS=False
SEED_USERS_RESET_EXISTING_PASSWORDS=False
SEED_USERS_FILE=seed/users.json
TIME_ZONE=UTC
LOG_LEVEL=INFO
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=1

# SQLite is the default. Set DB_ENGINE to the PostgreSQL engine to use PostgreSQL.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DATABASE_URL=

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
